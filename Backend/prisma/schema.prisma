generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum PublicationType {
  LIVE
  STATIC
}

enum PublicationStatus {
  ACTIVE
  FINISHED
  HIDDEN_BY_REPORTS
}

enum GangaActivationMode {
  MANUAL
  SCHEDULED
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  name          String
  phone         String
  is_moderator  Boolean  @default(false)
  created_at    DateTime @default(now())

  // Relations
  publications Publication[] @relation("SellerPublications")
  reservations Reservation[] @relation("BuyerReservations")
  reports      Report[]      @relation("UserReports")

  @@map("users")
}

model Zone {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  publications Publication[]

  @@map("zones")
}

model Category {
  id           Int             @id @default(autoincrement())
  name         String
  type         PublicationType
  publications Publication[]

  @@unique([name, type])
  @@map("categories")
}

model Publication {
  id          String            @id @default(uuid()) @db.Uuid
  type        PublicationType
  title       String
  description String            @db.Text
  price       Decimal           @db.Decimal(10, 2)
  price_before_ganga Decimal?    @db.Decimal(10, 2)
  image_url   String
  status      PublicationStatus @default(ACTIVE)
  created_at  DateTime          @default(now())

  // Base Relations
  seller_id   String   @db.Uuid
  seller      User     @relation("SellerPublications", fields: [seller_id], references: [id])
  zone_id     Int
  zone        Zone     @relation(fields: [zone_id], references: [id])
  category_id Int
  category    Category @relation(fields: [category_id], references: [id])

  // Campos exclusivos para LIVE
  initial_stock         Int?
  current_stock         Int? // CHECK publications_current_stock_nonnegative en PostgreSQL
  start_time            DateTime?
  end_time              DateTime?
  is_ganga_active       Boolean              @default(false)
  ganga_min_price       Decimal?             @db.Decimal(10, 2)
  ganga_activation_mode GangaActivationMode?
  ganga_minutes_before  Int?

  // Relations
  reservations Reservation[]
  reports      Report[]

  @@map("publications")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  status      ReservationStatus @default(ACTIVE)
  reserved_at DateTime          @default(now())
  resolved_at DateTime?
  unit_price Decimal @db.Decimal(10, 2)
  idempotency_key String @db.Uuid

  // Relations
  buyer_id       String      @db.Uuid
  buyer          User        @relation("BuyerReservations", fields: [buyer_id], references: [id])
  publication_id String      @db.Uuid
  publication    Publication @relation(fields: [publication_id], references: [id])

  @@unique([buyer_id, idempotency_key])
  @@index([status, reserved_at])
  @@map("reservations")
}

model Report {
  id         Int      @id @default(autoincrement())
  reason     String
  created_at DateTime @default(now())

  // Relations
  reporter_id    String      @db.Uuid
  reporter       User        @relation("UserReports", fields: [reporter_id], references: [id])
  publication_id String      @db.Uuid
  publication    Publication @relation(fields: [publication_id], references: [id])

  @@map("reports")
}
