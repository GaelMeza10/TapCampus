# Plantilla documental. Copiar a .env local y sustituir todos los valores de ejemplo.
# Nunca incluir credenciales reales en Git.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tapcampus?schema=public
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
REDIS_URL=redis://localhost:6379
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Opcionales; usar un origen accesible desde el dispositivo cuando se publique.
# PUBLIC_BASE_URL=https://api.example.com
# UPLOADS_DIR=uploads
