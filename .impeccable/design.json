  "narrative": {
    "northStar": "Marketplace fotográfico del campus",
    "overview": "La referencia Oakory aprobada se adapta a React Native/Expo: fondo casi blanco, verde UABC, Inter local y fotografías reales. La información de disponibilidad y precio acompaña al producto con encabezados compactos y controles familiares.\n\nEste documento describe el tema claro implementado. Las vistas web auxiliares permiten revisar composición; la aceptación de teclado, lector de pantalla y texto ampliado en hardware sigue pendiente.",
    "keyCharacteristics": [
      "Fotografía superior y contenido flexible.",
      "Superficies claras con contornos discretos.",
      "Verde para acciones y selección; naranja para Oferta."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Mantener Oferta en naranja y errores o acciones destructivas en rojo.",
        "section": "colors"
      },
      {
        "name": "The Compact Header Rule",
        "body": "Usar encabezados breves sin subtítulos redundantes; conservar instrucciones y mensajes necesarios.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do reutilizar theme.js y componentes compartidos.",
      "Do usar fotos reales de la API y una alternativa estable si faltan.",
      "Do permitir wrap y crecimiento de texto antes de recortar.",
      "Do conservar cuatro destinos y diferenciar precio vigente de precio fijado."
    ],
    "donts": [
      "Don't añadir carrito, favoritos ni calificaciones.",
      "Don't usar promociones inventadas para rellenar el destacado.",
      "Don't añadir sombras a Card como regla del sistema.",
      "Don't declarar hardware o tema oscuro verificados mediante capturas web."
    ]
  }
